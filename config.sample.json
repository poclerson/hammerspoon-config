{
  "events": {
    "keyDown": {
      "name": "Window.place",
      "keys": ["cmd", "alt", "shift", "f"]
    },
    "leftMouseUp": {
      "name": "Window.place",
      "config": {
        "w": 100,
        "h": 100,
        "x": 0,
        "y": 0
      }
    }
  },
  "gestures": {
    "enabled": true,
    "consume": true,
    "fingers": 4,
    "threshold": 0.15,
    "actions": {
      "up": {
        "name": "Window.move",
        "config": {
          "direction": "north",
          "duration": 0
        }
      },
      "down": {
        "name": "Window.move",
        "config": {
          "direction": "south",
          "duration": 0
        }
      },
      "left": {
        "name": "Window.move",
        "config": {
          "direction": "west",
          "duration": 0
        }
      },
      "right": {
        "name": "Window.move",
        "config": {
          "direction": "east",
          "duration": 0
        }
      }
    }
  },
  "window": {
    "default": {
      "w": 100,
      "h": 100,
      "duration": 0.2
    },
    "windowFocused": {
      "name": "Window.place",
      "config": {
        "w": 100,
        "h": 100
      }
    }
  }
}
